# Anthropic Claude API raktas – gaukite iš https://console.anthropic.com/
# Nukopijuokite šį failą į „.env“ ir įrašykite savo raktą.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelis (nebūtina). Numatytasis – pigesnis Sonnet.
# Kokybiškesnei analizei galima naudoti: claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-5-5
